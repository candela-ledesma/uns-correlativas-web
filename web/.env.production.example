# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://usuario:password@host:5432/uns_correlativas?schema=public"

# NextAuth
AUTH_SECRET="reemplazar-por-secreto-largo-y-unico"
AUTH_URL="https://tu-dominio.com"
NEXTAUTH_SECRET="reemplazar-por-secreto-largo-y-unico"
NEXTAUTH_URL="https://tu-dominio.com"

# Google OAuth (recomendado para produccion)
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""

# Seed inicial de admin
ADMIN_SEED_EMAIL="admin@tu-dominio.com"

# Endurecimiento de acceso para produccion
AUTH_ENABLE_DEV_LOGIN="false"
NEXT_PUBLIC_ENABLE_DEV_LOGIN="false"
AUTH_ALLOW_DEV_ROLE_OVERRIDE="false"
NEXT_PUBLIC_ALLOW_DEV_ROLE_OVERRIDE="false"

# Solo si habilitas dev-login temporalmente
AUTH_DEV_LOGIN_EMAIL_ALLOWLIST=""
