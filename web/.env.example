# Base de datos (SQLite local)
DATABASE_URL="file:./prisma/dev.db"

# NextAuth
AUTH_SECRET="cambia-esto-por-un-secreto-largo"
AUTH_URL="http://localhost:3000"

# Google OAuth (produccion)
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""

# Seed inicial de admin
ADMIN_SEED_EMAIL="admin@uns.local"

# Solo desarrollo/test: habilita provider credenciales para e2e
AUTH_ENABLE_DEV_LOGIN="false"
NEXT_PUBLIC_ENABLE_DEV_LOGIN="false"
