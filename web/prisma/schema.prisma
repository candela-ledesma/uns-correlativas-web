generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserActivityType {
  MATERIA_STATUS_CHANGED
  ACTIVE_CAREER_CHANGED
  PLAN_OPENED
  ONBOARDING_COMPLETED
  ONBOARDING_DISMISSED
  ONBOARDING_RESET
}

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String?            @unique
  emailVerified DateTime?
  image         String?
  role          Role               @default(USER)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  accounts      Account[]
  sessions      Session[]
  progresses    UserPlanProgress[]
  careerEnrollments UserCareerEnrollment[]
  preference    UserPreference?
  recentPlans   UserRecentPlan[]
  activities    UserActivity[]
  auditLogs     AuditLog[]         @relation("AuditActor")
  scheduleBlocks ScheduleBlock[]
}

model UserCareerEnrollment {
  id        String   @id @default(cuid())
  userId    String
  careerId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, careerId])
  @@index([userId, createdAt])
}

model UserPreference {
  userId                String    @id
  activeCareerId        String?
  onboardingCompletedAt DateTime?
  onboardingDismissedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRecentPlan {
  id        String   @id @default(cuid())
  userId    String
  careerId  String
  planId    String
  versionId String
  openedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, careerId])
  @@index([userId, openedAt])
}

model UserActivity {
  id          String           @id @default(cuid())
  userId      String
  type        UserActivityType
  careerId    String?
  planId      String?
  versionId   String?
  materiaKey  String?
  fromState   String?
  toState     String?
  metadataJson String?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model UserPlanProgress {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  versionId String
  stateJson String
  updatedAt DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planId, versionId])
  @@index([userId, updatedAt])
}

model ScheduleBlock {
  id            String   @id @default(cuid())
  userId        String
  careerId      String
  planId        String
  versionId     String
  materiaNombre String
  materiaId     String?
  dia           Int
  horaInicio    Int
  horaFin       Int
  comision      String?
  notas         String?
  color         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, careerId, planId, versionId])
}

model AdminConfig {
  id           String   @id @default("singleton")
  systemPrompt String
  version      String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model PlanPendiente {
  id        String   @id @default(cuid())
  slug      String   @unique
  planJson  String
  submittedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actorEmail   String?
  actorRole    Role?
  authProvider String   @default("unknown")
  action       String
  entityType   String
  entityId     String
  beforeJson   String?
  afterJson    String?
  reason       String?
  metadataJson String?
  createdAt    DateTime @default(now())
  actorUser    User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}
