{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:env": "set -a && . ./.env && . ./.env.local && set +a && prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:deploy:env": "set -a && . ./.env && . ./.env.local && set +a && prisma migrate deploy",
    "prisma:status:env": "set -a && . ./.env && . ./.env.local && set +a && prisma migrate status",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:prepare": "npm run prisma:deploy && npm run db:seed",
    "validate:data": "tsx scripts/validate-data.ts --format=human",
    "validate:data:json": "tsx scripts/validate-data.ts --format=json",
    "validate:data:strict": "tsx scripts/validate-data.ts --strict --format=human",
    "check:premerge": "npm run validate:data && npm test -- --run && npm run test:e2e -- tests/e2e/versionado.test.ts",
    "check:prod:env": "tsx scripts/check-prod-env.ts",
    "check:prod": "npm run check:prod:env && npm run prisma:generate && npm run validate:data && npm run lint && npm test -- --run && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.0.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.13.0",
    "@xyflow/react": "^12.10.2",
    "next": "^16.2.4",
    "next-auth": "^4.24.14",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "postcss": "^8.5.8",
    "prisma": "^6.13.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
