# Base de datos (PostgreSQL)
# En Vercel con Neon/Supabase: DATABASE_URL = URL con pgBouncer (pooled), DIRECT_URL = URL directa
DATABASE_URL="postgresql://usuario:password@host:5432/uns_correlativas?schema=public"
DIRECT_URL="postgresql://usuario:password@host:5432/uns_correlativas?schema=public"

# Opcional: base separada para E2E
DATABASE_URL_E2E="postgresql://usuario:password@host:5432/uns_correlativas_e2e?schema=public"

# NextAuth
AUTH_SECRET="supersecretkey"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="supersecretkey"
NEXTAUTH_URL="http://localhost:3000"

# Opcional: provider Google OAuth (recomendado para produccion)
# Para exportar al Google Calendar del usuario se necesitan estas credenciales.
# En Google Cloud Console: APIs & Services → Credentials → OAuth 2.0 Client ID (tipo Web application)
# Scope requerido: https://www.googleapis.com/auth/calendar.events
# Redirect URI autorizado: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""

# Seed inicial de admin
ADMIN_SEED_EMAIL="admin@uns.local"

# Solo desarrollo/test: habilita provider credenciales para e2e
AUTH_ENABLE_DEV_LOGIN="true"
NEXT_PUBLIC_ENABLE_DEV_LOGIN="true"

# Endurecimiento opcional del login de desarrollo
# En produccion se recomienda mantener ambos valores en "false"
AUTH_ALLOW_DEV_ROLE_OVERRIDE="true"
NEXT_PUBLIC_ALLOW_DEV_ROLE_OVERRIDE="true"

# Lista opcional de emails permitidos para dev-login (separados por coma)
# Ejemplo: "admin@uns.local,tester@uns.local"
AUTH_DEV_LOGIN_EMAIL_ALLOWLIST=""
